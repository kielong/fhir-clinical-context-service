# ORIGIN: AI — drafted by Claude Code, reviewed by Kiel
# Copy to .env (git-ignored). No secrets here: this is a local synthetic-data demo.
# Values below are HOST-side (scripts, tests, uvicorn on your laptop). docker-compose.yml
# overrides FHIR_BASE_URL and OLLAMA_HOST for the api container.

# ---- Postgres (used by HAPI) --------------------------------------------------
# Change these for anything that is not a laptop demo (e.g. Azure).
POSTGRES_DB=hapi
POSTGRES_USER=hapi
POSTGRES_PASSWORD=hapi
# JVM heap for HAPI. The biggest Synthea bundle is ~42 MB; Docker Desktop needs >= 8 GB RAM total
# for HAPI + Postgres + a 3B model (10 GiB recommended).
HAPI_JAVA_OPTS=-Xmx2g

# ---- FHIR ---------------------------------------------------------------------
FHIR_BASE_URL=http://localhost:8080/fhir
# Used only to build source links in the reviewer page. On Azure: the VM's public address.
PUBLIC_FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_TIMEOUT_SECONDS=10
# _count sent to HAPI: a PAGE size, not a cap. The client follows every `next` link.
FHIR_PAGE_SIZE=100
# Safety valve per resource type. Exceeded -> 502; never a silent cap.
FHIR_MAX_PAGES=50

# ---- Packet -------------------------------------------------------------------
LIST_CAP=25
# ORIGIN: H-spec — AS_OF_DATE is Kiel's decision (the dataset's reference date); the rest of
#   this file is AI.
# The Synthea 1K sample is frozen at 2019-09-16. Ages computed against today would be wrong.
# Unset (or empty) means "today" -- correct for a real EHR.
AS_OF_DATE=2019-09-16

# ---- Ollama -------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# Native Ollama instead of the container (much faster on Apple Silicon): run it on the host and start
# the stack with `API_OLLAMA_HOST=http://host.docker.internal:11434 docker compose up -d --scale ollama=0 --scale ollama-init=0`.
OLLAMA_MODEL=gemma3:4b
# One generation, a retry included (they share this budget). It starts when the model is free, so
# time spent queued behind another request does not use it. Generous for CPU-only.
OLLAMA_TIMEOUT_SECONDS=120
# How long a request waits for its summary, queue included. When it runs out the reviewer gets the
# facts with the summary marked unavailable (timeout). The model keeps going in the background and
# the finished summary is remembered, so the next request for the same patient has it.
SUMMARY_DEADLINE_SECONDS=45
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=160
# Ollama unloads models after 5 minutes by default; a cold 3B load stalls a live demo.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP=true
# Finished summaries remembered in memory so the same packet always gets the same words (0 = off).
# They are patient data held in RAM only, and are lost on restart.
SUMMARY_CACHE_SIZE=256

# ---- Seed ---------------------------------------------------------------------
SEED_DATA_DIR=data/synthea/fhir
SEED_PRIORITY_FILE=scripts/seed_priority.txt
# Total patient bundles to load (priority patients count first). Leave commented for all ~1,180.
# SEED_LIMIT=20
# Per bundle; the largest is ~42 MB / 18,488 entries.
SEED_TIMEOUT_SECONDS=900
